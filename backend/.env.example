# ─────────────────────────────────────────────
# Aetheris Health AI — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in values.
#   cp .env.example .env
# NEVER commit the filled .env file.

# ── App ──────────────────────────────────────
APP_NAME="Aetheris Health AI"
APP_ENV="development"
APP_DEBUG=true
APP_BASE_URL="http://localhost:8000"
APP_SECRET_KEY="change-me-to-a-long-random-string-in-production"

# ── Database ─────────────────────────────────
DATABASE_URL="postgresql+asyncpg://aetheris:aetheris@localhost:5432/aetheris"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ── Logging ──────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# ── CORS ─────────────────────────────────────
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'

# ── JWT (Sprint 2) ──────────────────────────
# JWT_PRIVATE_KEY="..."
# JWT_PUBLIC_KEY="..."
# JWT_ISSUER="aetheris"
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800

# ── AI Providers (Sprint 4) ─────────────────
# ANTHROPIC_API_KEY="sk-..."
# OPENAI_API_KEY="sk-..."
# GROQ_API_KEY="gsk_..."
# GOOGLE_API_KEY="..."

# ── Object Storage (Sprint 3) ───────────────
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_BUCKET="aetheris"

# ── Email / SMS (Sprint 3) ──────────────────
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASSWORD="..."
# EMAIL_FROM="noreply@aetheris.health"

# ── Rate Limiting ───────────────────────────
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_AI_PER_MIN=30
