# Base URL for the Aetheris backend API.
# Leave unset in dev to use the Vite proxy (/api -> http://localhost:8000).
VITE_API_URL=

# Dev-only mock login. When "true" AND running the dev server, the login form
# grants a demo session WITHOUT a backend. It is ignored in production builds.
# Leave empty/false to use the real /auth/login endpoint.
VITE_USE_MOCK_AUTH=
